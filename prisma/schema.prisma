generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String?
  targetRole     String?
  experience     String?
  xp             Int             @default(0)
  streak         Int             @default(0)
  createdAt      DateTime        @default(now())
  mastery        TopicMastery[]
  attempts       QuestionAttempt[]
  tests          Test[]
  xpTransactions XpTransaction[]
  studySessions  StudySession[]
}

model Topic {
  id          String         @id @default(cuid())
  name        String         @unique
  subtopics   Subtopic[]
  questions   Question[]
  mastery     TopicMastery[]
}

model Subtopic {
  id        String     @id @default(cuid())
  name      String
  topicId   String
  topic     Topic      @relation(fields: [topicId], references: [id])
  questions Question[]
  @@unique([topicId, name])
}

model Question {
  id          String           @id @default(cuid())
  topicId     String
  subtopicId  String?
  prompt      String
  type        String
  difficulty  Int
  options     Json?
  answer      Json
  explanation String
  topic       Topic            @relation(fields: [topicId], references: [id])
  subtopic    Subtopic?        @relation(fields: [subtopicId], references: [id])
  attempts    QuestionAttempt[]
}

model Test {
  id        String           @id @default(cuid())
  userId    String
  kind      String
  score     Float?
  completed Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])
  attempts  QuestionAttempt[]
}

model QuestionAttempt {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  testId     String?
  correct    Boolean
  answer     Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  question   Question @relation(fields: [questionId], references: [id])
  test       Test?    @relation(fields: [testId], references: [id])
}

model TopicMastery {
  id          String   @id @default(cuid())
  userId      String
  topicId     String
  score       Float    @default(0)
  recent      Float    @default(0)
  historical  Float    @default(0)
  retention   Float    @default(0)
  consistency Float    @default(0)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  topic       Topic    @relation(fields: [topicId], references: [id])
  @@unique([userId, topicId])
}

model XpTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  createdAt DateTime @default(now())
  user      User    @relation(fields: [userId], references: [id])
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  topicId   String?
  minutes   Int
  createdAt DateTime @default(now())
  user      User    @relation(fields: [userId], references: [id])
}
